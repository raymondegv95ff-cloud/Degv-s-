{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and online presence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "status": { "type": "string" },
        "phone": { "type": "string" },
        "lastSeen": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "username"]
    },
    "messages": {
      "title": "Messages",
      "description": "Real-time chat messages collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "isRead": { "type": "boolean" },
        "mediaUrl": { "type": "string" },
        "replyTo": { "type": "object" },
        "poll": { "type": "object" },
        "reactions": { "type": "object" },
        "expiresAt": { "type": "number" }
      },
      "required": ["senderId", "roomId"]
    },
    "rooms": {
      "title": "Rooms",
      "description": "Chat rooms and channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "unreadCount": { "type": "number" },
        "participants": { "type": "array" },
        "updatedAt": { "type": "number" }
      }
    },
    "calls": {
      "title": "Calls",
      "description": "WebRTC P2P Calling and Video Signaling collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerAvatar": { "type": "string" },
        "calleeId": { "type": "string" },
        "calleeName": { "type": "string" },
        "calleeAvatar": { "type": "string" },
        "roomId": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["callerId", "calleeId", "type", "status"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    match /users/{userId} {\n      allow read, write: if isAuthenticated() || true;\n    }\n    match /chats_rooms/{roomId} {\n      allow read, write: if isAuthenticated() || true;\n    }\n    match /rooms/{roomId} {\n      allow read, write: if isAuthenticated() || true;\n    }\n    match /messages/{messageId} {\n      allow read, write: if isAuthenticated() || true;\n    }\n    match /calls/{callId} {\n      allow read, write: if isAuthenticated() || true;\n      match /callerCandidates/{candidateId} {\n        allow read, write: if isAuthenticated() || true;\n      }\n      match /calleeCandidates/{candidateId} {\n        allow read, write: if isAuthenticated() || true;\n      }\n    }\n  }\n}"
}
