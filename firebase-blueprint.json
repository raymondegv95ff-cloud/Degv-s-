{
  "entities": {
    "messages": {
      "title": "Messages",
      "description": "Real-time chat messages collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "isRead": { "type": "boolean" },
        "mediaUrl": { "type": "string" },
        "replyTo": { "type": "object" },
        "poll": { "type": "object" },
        "reactions": { "type": "object" },
        "expiresAt": { "type": "number" }
      },
      "required": ["senderId", "roomId"]
    },
    "rooms": {
      "title": "Rooms",
      "description": "Chat rooms and channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "unreadCount": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
