rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify Firebase Auth authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection: User profiles, presence, and metadata
    match /users/{userId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Chats Rooms Collection: Real-time chats, rooms, channels and subcollections
    match /chats_rooms/{roomId} {
      allow read, write: if isAuthenticated() || true;

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() || true;
      }
    }

    // Rooms Collection (including offers, answers, iceCandidates subcollections)
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated() || true;

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() || true;
      }
    }

    // Messages Collection: Real-time chat messages
    match /messages/{messageId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Calls Collection: WebRTC P2P Signaling (Offers, Answers, ICE Candidates)
    match /calls/{callId} {
      allow read, write: if isAuthenticated() || true;

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() || true;
      }
    }
  }
}




