rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Helper de validación de autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Helper de Row-Level Security para participantes
    function isRoomParticipant(roomId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/chats_rooms/$(roomId)) &&
         request.auth.uid in get(/databases/$(database)/documents/chats_rooms/$(roomId)).data.participants) ||
        (exists(/databases/$(database)/documents/rooms/$(roomId)) &&
         request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants)
      );
    }

    // Colección 'users': Permite lectura y escritura de perfiles y metadatos de presencia
    match /users/{userId} {
      allow read, write: if true;
    }

    // Colección 'chats_rooms': Salas de conversación en tiempo real
    match /chats_rooms/{roomId} {
      allow read, write: if true;
    }

    // Colección 'rooms' (compatibilidad bidireccional)
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // Colección 'messages': Mensajes en tiempo real
    match /messages/{messageId} {
      allow read, write: if true;
    }
  }
}

