rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Authenticated users can list/read user directory, but only owner can write/edit their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.id == request.auth.uid);
      allow delete: if isOwner(userId);
    }

    // Rooms Collection (Conversations & Group Channels)
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Chats Rooms Collection: Legacy & Group Chats
    match /chats_rooms/{roomId} {
      allow read, write: if isAuthenticated();
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Direct Messages & Real-Time Messages Collection
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Nested Conversations Collection: conversations/{conversationId}/messages/{messageId}
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Calls Collection: WebRTC P2P Signaling (Offers, Answers, ICE Candidates)
    match /calls/{callId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Platform Updates & Sync Collection
    match /platform_updates/{updateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // System Status & Cross-Platform Health
    match /system_status/{statusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
