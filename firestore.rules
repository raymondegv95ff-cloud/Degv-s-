rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMessageSender() {
      return isAuthenticated() && (
        request.auth.uid == request.resource.data.senderId ||
        (request.resource.data.senderId == null && isAuthenticated())
      );
    }

    function isStrictMessageSender() {
      return isAuthenticated() && (
        request.auth.uid == request.resource.data.senderId ||
        request.auth.uid == resource.data.senderId
      );
    }

    function isStatusOrReceiptUpdate() {
      // Allows recipient or participant to update delivery ('delivered'), read status ('read', 'isRead'), reactions and timestamps
      // while ensuring senderId and message content cannot be altered.
      return isAuthenticated() &&
        request.resource.data.senderId == resource.data.senderId &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isRead', 'readAt', 'updatedAt', 'reactions', 'readBy']) ||
          (
            request.resource.data.status in ['sent', 'delivered', 'read', 'failed', 'pending'] &&
            (!('text' in resource.data) || request.resource.data.text == resource.data.text) &&
            (!('content' in resource.data) || request.resource.data.content == resource.data.content)
          )
        );
    }

    // Users Collection: Authenticated users can list/read user directory, but only owner can write/edit their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.id == request.auth.uid);
      allow delete: if isOwner(userId);
    }

    // Rooms Collection (Conversations & Group Channels)
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Chats Rooms Collection: Legacy & Group Chats
    match /chats_rooms/{roomId} {
      allow read, write: if isAuthenticated();
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Direct Messages & Real-Time Messages Collection (Legacy Compatibility)
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.senderId || request.resource.data.senderId == null);
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        isStatusOrReceiptUpdate()
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || resource.data.senderId == null);

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Canonical Nested Conversations Collection: conversations/{conversationId}/messages/{messageId}
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderId;
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          isStatusOrReceiptUpdate()
        );
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Calls Collection: WebRTC P2P Signaling (Offers, Answers, ICE Candidates)
    match /calls/{callId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Platform Updates & Sync Collection
    match /platform_updates/{updateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // System Status & Cross-Platform Health
    match /system_status/{statusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}

