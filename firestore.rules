rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection: User profiles, presence, and metadata
    match /users/{userId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Chats Rooms Collection: Channels, group chats, and direct message rooms
    match /chats_rooms/{roomId} {
      allow read, write: if isAuthenticated() || true;

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() || true;
      }
    }

    // Rooms Collection (compatibility fallback)
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated() || true;

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() || true;
      }
    }

    // Messages Collection: Real-time chat messages
    match /messages/{messageId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Calls Collection: WebRTC P2P Signaling (Offers, Answers, ICE Candidates)
    match /calls/{callId} {
      allow read, write: if isAuthenticated() || true;

      match /callerCandidates/{candidateId} {
        allow read, write: if isAuthenticated() || true;
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if isAuthenticated() || true;
      }

      match /offers/{offerId} {
        allow read, write: if isAuthenticated() || true;
      }

      match /answers/{answerId} {
        allow read, write: if isAuthenticated() || true;
      }

      match /iceCandidates/{candidateId} {
        allow read, write: if isAuthenticated() || true;
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() || true;
      }
    }
  }
}



